    {
      "id": "agent17-001",
      "name": "Complete ICSR - All Criteria MET",
      "description": "All four minimum criteria present across receipts; day zero computed",
      "priority": "critical",
      "tags": ["positive-control", "valid-icsr", "all-met"],
      "input": {
        "caseId": "CASE-001",
        "source_type": "spontaneous",
        "receipts": [
          {
            "event_id": "EVT-001",
            "date": "2024-01-10",
            "received_by": "mah",
            "text": "Dr. John Smith, Cardiologist at City Hospital, reported the event. Patient John Doe, male, 45 years old, experienced adverse event."
          },
          {
            "event_id": "EVT-002",
            "date": "2024-01-12",
            "received_by": "mah",
            "text": "Patient was taking DrugX 100mg daily. Adverse reaction: severe hepatotoxicity requiring hospitalization."
          }
        ],
        "seriousness": true,
        "region": { "name": "EU", "serious_days": 15, "nonserious_days": 90 },
        "reporter_policy": "any_one"
      },
      "expected_output": {
        "valid_icsr": true,
        "day_zero": "2024-01-12",
        "missing_criteria": [],
        "due_date_serious": "2024-01-27",
        "due_date_nonserious": "2024-04-11",
        "applicable_due_date": "2024-01-27"
      }
    },
    {
