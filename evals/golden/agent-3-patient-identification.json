  "test_cases": [
    {
      "id": "agent3-001",
      "name": "Complete Patient Identification",
      "description": "Patient record with all critical fields populated",
      "priority": "critical",
      "tags": ["patient", "complete"],
      "input": {
        "intakeRecordId": "REC-001",
        "tenantId": "test-tenant",
        "entities": {
          "patients": [
            {
              "patient_initials": "JD",
              "sex": "MALE",
              "age_value": 45,
              "age_unit": "YEAR",
              "age_group": "ADULT",
              "date_of_birth": "1979-05-15",
              "weight_kg": 80,
              "weight_unit": "KG",
              "height_cm": 180,
              "height_unit": "CM",
              "medical_history": "Hypertension, Type 2 Diabetes"
            }
          ]
        }
      },
      "expected_output": {
        "systemSnapshot": {
          "assessments": [
            { "field": "PATIENT_INITIALS", "status": "COMPLETE", "value": "JD" },
            { "field": "SEX", "status": "COMPLETE", "value": "MALE" },
            { "field": "AGE", "status": "COMPLETE", "value": "45 YEAR" },
            { "field": "AGE_GROUP", "status": "COMPLETE", "value": "ADULT" },
            { "field": "DATE_OF_BIRTH", "status": "COMPLETE", "value": "1979-05-15" },
            { "field": "WEIGHT", "status": "COMPLETE", "value": "80 KG" },
            { "field": "HEIGHT", "status": "COMPLETE", "value": "180 CM" },
            { "field": "MEDICAL_HISTORY", "status": "COMPLETE", "value": "Hypertension, Type 2 Diabetes" }
          ],
          "completenessScore": 100,
          "criticalFieldsPresent": 8,
          "totalCriticalFields": 8,
          "overallStatus": "COMPLETE",
          "followUpRequired": false,
          "followUpReasons": []
        }
      }
    },
