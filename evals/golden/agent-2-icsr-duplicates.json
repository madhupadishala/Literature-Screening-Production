{
  "agent_id": "agent-2-icsr-duplicates",
  "version": "1.0",
  "test_cases": [
    {
      "id": "agent2-001",
      "name": "Exact PMID Match",
      "description": "Two records with same PMID should match with exact score",
      "priority": "critical",
      "tags": ["exact-match", "pmid"],
      "input": {
        "candidate": {
          "pmid": "12345678",
          "title": "Hepatotoxicity with DrugX",
          "authors": ["Smith J", "Doe A"],
          "journal": "Liver Journal",
          "year": 2024,
          "abstract": "Patient developed liver injury after DrugX administration",
          "source": "pubmed",
          "sourceId": "pubmed-12345678"
        },
        "existingRecords": [
          {
            "id": "embase-12345678",
            "pmid": "12345678",
            "title": "Hepatotoxicity with DrugX - Duplicate",
            "authors": ["Smith J", "Doe A"],
            "journal": "Liver Journal",
            "year": 2024,
            "abstract": "Patient developed liver injury after DrugX administration",
            "source": "europepmc",
            "sourceId": "embase-12345678"
          },
          {
            "id": "local-001",
            "pmid": "87654321",
            "title": "Different Study",
            "authors": ["Brown K"],
            "year": 2023,
            "source": "internal",
            "sourceId": "local-001"
          }
        ],
        "threshold": 0.7
      },
      "expected_output": {
        "duplicates": [
          {
            "record": {
              "id": "embase-12345678",
              "pmid": "12345678",
              "source": "europepmc",
              "sourceId": "embase-12345678"
            },
            "score": 1.0,
            "matchType": "exact",
            "matchedFields": ["pmid"]
          }
        ],
        "totalChecked": 2,
        "processingTimeMs": { "min": 0 }
      }
    },
