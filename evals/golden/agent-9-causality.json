            "end_date": "2024-02-05",
            "outcome": "RECOVERED",
            "seriousness": "SERIOUS",
            "seriousness_criteria": ["HOSPITALIZATION"]
          }
        ],
        "reporter_causality": [
          {
            "drug": "DrugX",
            "event": "Hepatotoxicity",
            "related": true,
            "rationale": "Positive dechallenge and rechallenge confirm causality"
          }
