      "input": {
        "case_id": "CAUS-001",
        "narrative": "A 45-year-old male patient started DrugX 100mg daily on 2024-01-01 for hypertension. On 2024-01-20, he developed severe hepatotoxicity with ALT 1500 U/L and was hospitalized. DrugX was discontinued on 2024-01-21. Liver enzymes normalized by 2024-02-05. Patient was rechallenged with DrugX 50mg on 2024-03-01 and hepatotoxicity recurred within 5 days with ALT 1200 U/L. No alternative causes identified.",
        "drugs": [
          {
            "name": "DrugX",
            "active_substance": "SubstanceX",
            "dose": "100mg",
            "route": "ORAL",
            "frequency": "ONCE DAILY",
            "therapy_start": "2024-01-01",
            "therapy_end": "2024-01-21",
            "action_taken": "DRUG_WITHDRAWN",
            "rechallenge": "YES",
            "dechallenge": "POSITIVE",
            "role": "suspect"
          }
        ],
        "events": [
          {
            "meddra_llt": "Hepatotoxicity",
            "meddra_pt": "Drug-induced liver injury",
            "verbatim_text": "Severe hepatotoxicity with ALT 1500 U/L",
