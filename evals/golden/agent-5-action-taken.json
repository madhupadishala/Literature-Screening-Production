    {
      "id": "agent5-001",
      "name": "Drug Withdrawn - Serious Event",
      "description": "Serious event with drug withdrawal - should be guideline appropriate",
      "priority": "critical",
      "tags": ["drug-withdrawn", "serious", "guideline-appropriate"],
      "input": {
        "case_id": "ACT-001",
        "drug_exposure": {
          "drug_name": "DrugX",
          "active_substance": "SubstanceX",
          "dose": "100mg",
          "route": "ORAL",
          "frequency": "ONCE DAILY",
          "therapy_start": "2024-01-01",
          "therapy_end": "2024-01-20",
          "action_taken": "DRUG_WITHDRAWN"
        },
        "adverse_event": {
          "meddra_llt": "Hepatotoxicity",
          "onset_date": "2024-01-15",
          "outcome": "RECOVERED",
          "seriousness": "SERIOUS",
          "seriousness_criteria": ["HOSPITALIZATION"]
        },
        "dechallenge_result": "POSITIVE",
        "rechallenge_result": "UNKNOWN",
        "clinical_guidelines": [
          { "drug_class": "Hepatotoxic drugs", "recommended_action": "DRUG_WITHDRAWN", "evidence_level": "B" }
        ]
      },
      "expected_output": {
        "assessment": {
          "action_taken": "DRUG_WITHDRAWN",
          "confidence": { "min": 0.8 },
          "appropriate_per_guidelines": true,
          "guideline_reference": { "contains": "Hepatotoxic drugs" },
          "dechallenge_correlation": "CONSISTENT",
          "supporting_evidence": { "length_min": 1 }
        }
      }
    },
