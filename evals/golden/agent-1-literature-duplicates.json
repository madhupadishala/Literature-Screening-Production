        }
      }
    },
    {
      "id": "agent1-008",
      "name": "Large Batch - 100 Records",
      "description": "Performance test with 100 records - some duplicates, some unique",
      "priority": "medium",
      "tags": ["performance", "large-batch"],
      "input": {
        "records": [
          {"pmid": "10000001", "title": "Study on DrugA", "abstract": "Abstract 1", "authors": ["Author A"], "publication_year": 2024, "source": "PUBMED", "source_id": "pubmed-10000001", "chemicals": ["DrugA"]},
          {"pmid": "10000001", "title": "Study on DrugA - Duplicate", "abstract": "Abstract 1", "authors": ["Author A"], "publication_year": 2024, "source": "EMBASE", "source_id": "embase-10000001", "chemicals": ["DrugA"]},
          {"doi": "10.1000/test1", "title": "DrugX Safety Profile", "abstract": "Review of DrugX", "authors": ["Jones K"], "source": "PUBMED", "source_id": "pubmed-999", "chemicals": ["DrugX"]},
          {"doi": "10.1000/drugx.2024.001", "title": "DrugX Safety Profile", "abstract": "Review of DrugX", "authors": ["Jones K"], "source": "LOCAL", "source_id": "local-001", "chemicals": ["DrugX"]},
          {"title": "Hepatotoxicity Associated with DrugX", "abstract": "A 45-year-old patient developed severe hepatotoxicity after 3 weeks of DrugX therapy", "authors": ["Smith J", "Brown T"], "publication_year": 2024, "source": "PUBMED", "source_id": "pubmed-111", "chemicals": ["DrugX"]},
          {"title": "DrugX-Induced Hepatotoxicity: A Case Report", "abstract": "A 45-year-old patient developed severe hepatotoxicity after three weeks of DrugX therapy", "authors": ["Smith J", "Brown T"], "publication_year": 2024, "source": "EMBASE", "source_id": "embase-222", "chemicals": ["DrugX"]}
        ],
        "similarity_threshold": 0.85,
        "enable_fuzzy_matching": true,
        "generate_batch_size": 100
      },
      "expected_output": {
        "total_records": 6,
        "duplicate_count": { "min": 2 },
        "unique_count": { "max": 4 },
        "processing_stats": {
          "processing_time_ms": { "max": 5000 }
        }
      }
    }
  ]
