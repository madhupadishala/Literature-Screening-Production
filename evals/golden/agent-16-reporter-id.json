      "description": "Physician reporter with qualification, organization, and contact info",
      "priority": "critical",
      "tags": ["positive-control", "hcp-reporter", "full-details"],
      "input": {
        "caseId": "CASE-001",
        "narrative": "Dr. John Smith, MD, Cardiologist at City Hospital, 123 Main St, New York, NY 10001, USA. Phone: +1-555-123-4567. Email: jsmith@cityhospital.com. Reported adverse event for patient.",
        "existingReporters": []
      },
      "expected_output": {
        "reporters": [
          {
            "given_name": "John",
            "family_name": "Smith",
            "initials": "M.D.",
            "organisation": "City Hospital",
            "street": "123 Main St",
            "city": "New York",
            "state": "NY",
            "postcode": "10001",
            "country_iso2": "US",
            "telephone": "1-555-123-4567",
            "email": "jsmith@cityhospital.com",
            "qualification_code": 1,
            "qualification_text": "MD",
            "primary_source_for_regulatory_purposes": true
          }
        ],
        "reporter_identifiable": true,
        "contains_personal_data": true
      }
    },
    {
      "id": "agent16-002",
