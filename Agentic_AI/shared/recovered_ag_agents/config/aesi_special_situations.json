    "neuropsychiatric": ["suicidal ideation", "suicide attempt", "seizure", "convulsion", "Guillain-Barré", "Guillain-Barre", "encephalopathy", "psychosis"],
    "haematological": ["agranulocytosis", "aplastic anaemia", "aplastic anemia", "thrombocytopenia", "neutropenia", "pancytopenia", "haemolytic anaemia", "hemolytic anemia"],
