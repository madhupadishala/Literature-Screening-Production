NODE_ENV=production
APP_NAME=ClinixAI Literature Screening
APP_VERSION=0.1.0
APP_REGION=centralindia
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/clinixai
DATABASE_SSL_MODE=require
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
AI_PROVIDER=groq
GROQ_API_KEY=replace-in-azure-secret
GROQ_MODEL=llama-3.3-70b-versatile
# Optional but strongly recommended for real PubMed pulls: raises NCBI's
# rate limit from 3 req/s to 10 req/s. Get one free at
# https://www.ncbi.nlm.nih.gov/account/settings/ (API Key Management).
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=ClinixAI
EVIDENCE_STORE_BACKEND=database
KNOWLEDGE_ROOT=/app/knowledge
CLINIXAI_KNOWLEDGE_ROOT=/app/knowledge
INTERNAL_MONITORING_TOKEN=replace-with-at-least-32-random-characters
BUILD_SHA=replace-with-git-commit-sha
RELEASE_VERSION=0.1.0
RELEASE_BASE_URL=https://replace-with-azure-container-app-fqdn
ALLOW_DEMO_PRINCIPAL=false
DEFAULT_TENANT_KEY=demo-tenant
PORT=3000
HOSTNAME=0.0.0.0

# Shared PV agent candidates. Enable only after approved qualification.
NEXUS_SERIOUSNESS_ENABLED=false
NEXUS_DRUG_ROLE_ENABLED=false
NEXUS_CAUSALITY_ENABLED=false
NEXUS_SERIOUSNESS_AGENT_URL=
NEXUS_SERIOUSNESS_AGENT_TOKEN=
NEXUS_PV_AGENT_URL=
NEXUS_PV_AGENT_TOKEN=

# Production diagnostic endpoint is opt-in; verifier is supplied securely.
NEXUS_ENABLE_PRODUCTION_E2E=false
NEXUS_PROD_E2E_TOKEN_SHA256=
